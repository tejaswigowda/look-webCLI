--- /dev/null
+++ b/app/src/module/FreeAccessories.ts
@@ -0,0 +1,210 @@
+// Free accessories: small models built in code with three.js primitives and exported as GLB when you click one.
+// They are not downloaded and carry no third-party asset, texture or license: they are released as CC0 with this repository.
+//
+// Everything is modeled facing +Z with the origin at the bone it attaches to and sizes in meters, for a VRoid-sized head
+// (the head bone sits at the base of the skull: the eyes are about 6.6 cm above it, the top of the head about 20 cm). VRM 0.x files face -Z, so
+// those get a 180 degree turn about Y at placement (see defaultsFor). Move, rotate and scale with the gizmo afterwards.
+import * as THREE from 'three'
+import { GLTFExporter } from 'three/examples/jsm/exporters/GLTFExporter.js'
+
+export interface FreeAccessoryDef {
+  id: string
+  label: string
+  icon: string
+  bone: string
+  color: string // default color (hex)
+  build: (color: any) => any
+}
+
+const mat = (c: any, rough = 0.55, metal = 0) =>
+  new THREE.MeshStandardMaterial({ color: new THREE.Color(c as any), roughness: rough, metalness: metal, side: THREE.DoubleSide })
+
+const mesh = (g: any, m: any, x = 0, y = 0, z = 0, rx = 0, ry = 0, rz = 0) => {
+  const o = new THREE.Mesh(g, m)
+  o.position.set(x, y, z)
+  o.rotation.set(rx, ry, rz)
+  return o
+}
+
+const EYE_Y = 0.066 // eye height over the head bone
+const FRONT = 0.108 // how far in front of the bone the face is at eye height
+
+function glasses(color: any, square: boolean, dark: boolean): any {
+  const g = new THREE.Group()
+  const frame = mat(color, 0.4, 0.2)
+  const lens = new THREE.MeshStandardMaterial({ color: dark ? 0x111111 : 0xbfe3ff, roughness: 0.1, metalness: 0, transparent: true, opacity: dark ? 0.85 : 0.25, side: THREE.DoubleSide })
+  for (const s of [-1, 1]) {
+    const x = s * 0.034
+    if (square) {
+      const shape = new THREE.Shape()
+      const w = 0.026, h = 0.019, r = 0.006
+      shape.moveTo(-w + r, -h); shape.lineTo(w - r, -h); shape.quadraticCurveTo(w, -h, w, -h + r); shape.lineTo(w, h - r); shape.quadraticCurveTo(w, h, w - r, h)
+      shape.lineTo(-w + r, h); shape.quadraticCurveTo(-w, h, -w, h - r); shape.lineTo(-w, -h + r); shape.quadraticCurveTo(-w, -h, -w + r, -h)
+      const hole = new THREE.Path(); const w2 = w - 0.003, h2 = h - 0.003
+      hole.moveTo(-w2, -h2); hole.lineTo(w2, -h2); hole.lineTo(w2, h2); hole.lineTo(-w2, h2); hole.lineTo(-w2, -h2)
+      shape.holes.push(hole)
+      g.add(mesh(new THREE.ExtrudeGeometry(shape, { depth: 0.004, bevelEnabled: false }), frame, x, EYE_Y, FRONT))
+      g.add(mesh(new THREE.PlaneGeometry(2 * w2, 2 * h2), lens, x, EYE_Y, FRONT + 0.002))
+    } else {
+      g.add(mesh(new THREE.TorusGeometry(0.025, 0.0026, 10, 40), frame, x, EYE_Y, FRONT + 0.002))
+      g.add(mesh(new THREE.CircleGeometry(0.0245, 32), lens, x, EYE_Y, FRONT + 0.002))
+    }
+    // temple arm from the lens edge back to the ear
+    const len = FRONT - (-0.02)
+    g.add(mesh(new THREE.CylinderGeometry(0.0017, 0.0017, len, 8), frame, s * 0.072, EYE_Y + 0.004, FRONT - len / 2, Math.PI / 2))
+  }
+  g.add(mesh(new THREE.TorusGeometry(0.008, 0.0022, 8, 16, Math.PI), frame, 0, EYE_Y + 0.006, FRONT + 0.002)) // bridge
+  return g
+}
+
+function dome(color: any, r: number, y: number, z: number, from = 0, to = Math.PI / 2) {
+  return mesh(new THREE.SphereGeometry(r, 36, 18, 0, Math.PI * 2, from, to), mat(color), 0, y, z)
+}
+
+export const FREE_ACCESSORIES: FreeAccessoryDef[] = [
+  { id: 'glasses-round', label: 'Round glasses', icon: '👓', bone: 'head', color: '#2b2b2b', build: c => glasses(c, false, false) },
+  { id: 'glasses-square', label: 'Square glasses', icon: '🤓', bone: 'head', color: '#111111', build: c => glasses(c, true, false) },
+  { id: 'sunglasses', label: 'Sunglasses', icon: '🕶️', bone: 'head', color: '#111111', build: c => glasses(c, true, true) },
+  {
+    id: 'cap', label: 'Cap', icon: '🧢', bone: 'head', color: '#2f5fd0', build: c => {
+      const g = new THREE.Group()
+      g.add(dome(c, 0.136, 0.09, -0.012, 0, Math.PI / 2))
+      g.add(mesh(new THREE.CylinderGeometry(0.136, 0.136, 0.014, 36, 1, true), mat(c), 0, 0.09, -0.012))
+      // the brim: a half disc in front, tilted down a little
+      const brim = mesh(new THREE.CircleGeometry(0.1, 28, 0, Math.PI), mat(c), 0, 0.094, 0.108, Math.PI / 2 + 0.12)
+      brim.scale.set(1.05, 0.7, 1)
+      g.add(brim)
+      return g
+    }
+  },
+  {
+    id: 'top-hat', label: 'Top hat', icon: '🎩', bone: 'head', color: '#1a1a1f', build: c => {
+      const g = new THREE.Group()
+      g.add(mesh(new THREE.CylinderGeometry(0.098, 0.1, 0.13, 36), mat(c, 0.5), 0, 0.29, -0.012))
+      g.add(mesh(new THREE.CylinderGeometry(0.16, 0.16, 0.008, 40), mat(c, 0.5), 0, 0.226, -0.012))
+      g.add(mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.03, 36, 1, true), mat('#b02a3a', 0.6), 0, 0.245, -0.012))
+      return g
+    }
+  },
+  {
+    id: 'cat-ears', label: 'Cat ears', icon: '🐱', bone: 'head', color: '#f4a8c8', build: c => {
+      const g = new THREE.Group(); const band = mat('#222222')
+      g.add(mesh(new THREE.TorusGeometry(0.118, 0.005, 8, 40, Math.PI), band, 0, 0.1, -0.012, 0, 0, 0))
+      for (const s of [-1, 1]) {
+        g.add(mesh(new THREE.ConeGeometry(0.036, 0.075, 3), mat(c), s * 0.072, 0.232, -0.01, 0, 0, -s * 0.32))
+        g.add(mesh(new THREE.ConeGeometry(0.022, 0.05, 3), mat('#ffd7e6'), s * 0.07, 0.228, -0.003, 0, 0, -s * 0.32))
+      }
+      return g
+    }
+  },
+  {
+    id: 'bunny-ears', label: 'Bunny ears', icon: '🐰', bone: 'head', color: '#ffffff', build: c => {
+      const g = new THREE.Group()
+      g.add(mesh(new THREE.TorusGeometry(0.118, 0.005, 8, 40, Math.PI), mat('#dddddd'), 0, 0.1, -0.012))
+      for (const s of [-1, 1]) {
+        const e = mesh(new THREE.CapsuleGeometry(0.026, 0.12, 6, 16), mat(c), s * 0.055, 0.31, -0.01, 0, 0, -s * 0.16); e.scale.set(1, 1, 0.55)
+        g.add(e)
+        const i = mesh(new THREE.CapsuleGeometry(0.014, 0.09, 6, 12), mat('#ffb6cb'), s * 0.055, 0.31, 0.003, 0, 0, -s * 0.16); i.scale.set(1, 1, 0.4)
+        g.add(i)
+      }
+      return g
+    }
+  },
+  {
+    id: 'headband', label: 'Headband', icon: '🎀', bone: 'head', color: '#e0415a', build: c => {
+      const g = new THREE.Group()
+      const b = mesh(new THREE.TorusGeometry(0.118, 0.008, 8, 48), mat(c), 0, 0.15, -0.012, Math.PI / 2, 0, 0)
+      b.scale.set(1, 1.07, 1.4)
+      g.add(b)
+      return g
+    }
+  },
+  {
+    id: 'crown', label: 'Crown', icon: '👑', bone: 'head', color: '#f2c230', build: c => {
+      const g = new THREE.Group(); const m = mat(c, 0.25, 0.8)
+      g.add(mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.035, 32, 1, true), m, 0, 0.225, -0.012))
+      for (let i = 0; i < 6; i++) {
+        const a = (i / 6) * Math.PI * 2
+        g.add(mesh(new THREE.ConeGeometry(0.014, 0.05, 6), m, Math.sin(a) * 0.1, 0.268, -0.012 + Math.cos(a) * 0.1))
+        g.add(mesh(new THREE.SphereGeometry(0.007, 10, 8), mat('#d4233a', 0.2), Math.sin(a) * 0.1, 0.298, -0.012 + Math.cos(a) * 0.1))
+      }
+      return g
+    }
+  },
+  {
+    id: 'halo', label: 'Halo', icon: '😇', bone: 'head', color: '#ffe27a', build: c => {
+      const m = new THREE.MeshStandardMaterial({ color: c, emissive: c, emissiveIntensity: 0.6, roughness: 0.3, metalness: 0.4 })
+      return mesh(new THREE.TorusGeometry(0.08, 0.006, 10, 48), m, 0, 0.34, -0.012, Math.PI / 2)
+    }
+  },
+  {
+    id: 'bow-tie', label: 'Bow tie', icon: '🎀', bone: 'neck', color: '#b02a3a', build: c => {
+      const g = new THREE.Group(); const m = mat(c)
