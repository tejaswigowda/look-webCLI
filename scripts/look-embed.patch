+export function patternDataUrl(spec: PatternSpec, size = 56): string {
+  const big = document.createElement('canvas'); big.width = big.height = 256
+  drawPattern(big.getContext('2d') as CanvasRenderingContext2D, 256, spec)
+  const o = document.createElement('canvas'); o.width = o.height = size
+  ;(o.getContext('2d') as CanvasRenderingContext2D).drawImage(big, 0, 0, size, size)
+  return o.toDataURL('image/png')
+}
