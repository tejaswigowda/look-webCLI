+// Outfit tools: list, recolor, retexture, hide, restore and delete the garments of a VRM, and apply generated patterns and outfit presets.
+// Everything works on the loaded VRM's JSON and binary chunk (VRMParser), like the other tabs, so the result is exported with the VRM.
+// Patterns are drawn on a canvas in code: nothing is downloaded and there is no third-party asset (CC0 with this repository).
+import VRMParser from '@/module/VRMParser'
+
+export type GarmentKind = 'tops' | 'bottoms' | 'shoes' | 'onepiece' | 'other'
+
+export interface Garment {
+  materialIndex: number
+  name: string
+  kind: GarmentKind
+  primitives: number // primitives that use it in the scene right now
+  hidden: boolean
+  color: string // the material's color factor as #rrggbb
+  imageIndex: number | null
+}
+
+export interface PatternSpec { pattern: string; c1: string; c2: string; scale?: number }
+export interface OutfitPreset { id: string; label: string; icon: string; parts: Partial<Record<GarmentKind, PatternSpec | { color: string }>> }
+
+const CLOTH = /_CLOTH$/
+const KINDS: Array<[RegExp, GarmentKind]> = [[/_Tops_/, 'tops'], [/_Bottoms_/, 'bottoms'], [/_Shoes_/, 'shoes'], [/_Onepi?e?ce_|_Onepiece_/i, 'onepiece']]
+
+// hidden primitives are kept here (not in the file) so they can be restored; deleting forgets them
+interface Stash { meshIndex: number; prim: any; materialIndex: number }
+const stash: Stash[] = []
+
+const srgbToLinear = (c: number) => (c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4))
+const linearToSrgb = (c: number) => (c <= 0.0031308 ? c * 12.92 : 1.055 * Math.pow(c, 1 / 2.4) - 0.055)
+const hexToRgb = (hex: string): [number, number, number] => { const n = parseInt(hex.replace('#', ''), 16); return [(n >> 16) & 255, (n >> 8) & 255, n & 255] }
+const rgbToHex = (r: number, g: number, b: number) => '#' + [r, g, b].map(v => Math.round(Math.min(255, Math.max(0, v))).toString(16).padStart(2, '0')).join('')
+
+function kindOf(name: string): GarmentKind {
+  for (const [re, k] of KINDS) if (re.test(name)) return k
+  return 'other'
+}
+
+function isGarmentName(name: string) { return CLOTH.test(name || '') }
+
+function usedBy(materialIndex: number): number {
+  let n = 0
+  for (const m of VRMParser.json.meshes || []) for (const p of m.primitives) if (p.material === materialIndex) n++
+  return n
+}
+
+export function listGarments(): Garment[] {
+  const json = VRMParser.json
+  if (!json || !json.materials) return []
+  const out: Garment[] = []
+  const seen = new Set<number>()
+  json.materials.forEach((m: any, i: number) => {
+    if (!isGarmentName(m.name)) return
+    seen.add(i)
+    out.push(describe(i))
+  })
+  // a hidden garment's material still exists, so it stays in the list; one that was deleted is gone from the stash and the scene
+  return out
+}
+
+function describe(i: number): Garment {
+  const json = VRMParser.json, m = json.materials[i]
+  const f = (m.pbrMetallicRoughness && m.pbrMetallicRoughness.baseColorFactor) || [1, 1, 1, 1]
+  const tex = m.pbrMetallicRoughness && m.pbrMetallicRoughness.baseColorTexture
+  const src = tex && json.textures && json.textures[tex.index] ? json.textures[tex.index].source : null
