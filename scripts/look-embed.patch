+
+/** Points one material at a new image (a new texture, so other materials sharing the old texture are not touched), MToon shade texture included. */
+function setMaterialImage(materialIndex: number, imageIndex: number) {
+  const json = VRMParser.json, m = json.materials[materialIndex]
+  json.textures = json.textures || []
+  const old = m.pbrMetallicRoughness.baseColorTexture
+  const sampler = old && json.textures[old.index] ? json.textures[old.index].sampler : undefined
+  const tex: any = { source: imageIndex }
+  if (sampler !== undefined) tex.sampler = sampler
+  json.textures.push(tex)
+  const ti = json.textures.length - 1
+  m.pbrMetallicRoughness.baseColorTexture = { ...(old || {}), index: ti, texCoord: old && old.texCoord ? old.texCoord : 0 }
+  const vrm0 = json.extensions && json.extensions.VRM && json.extensions.VRM.materialProperties && json.extensions.VRM.materialProperties[materialIndex]
+  if (vrm0) { vrm0.textureProperties = vrm0.textureProperties || {}; vrm0.textureProperties._MainTex = ti; vrm0.textureProperties._ShadeTexture = ti }
+  const mtoon = m.extensions && m.extensions.VRMC_materials_mtoon
+  if (mtoon) mtoon.shadeMultiplyTexture = { index: ti }
+}
+
+function whiten(materialIndex: number) {
+  // the pattern carries the color: the material color must not tint it
+  const json = VRMParser.json, m = json.materials[materialIndex]
+  const a = (m.pbrMetallicRoughness.baseColorFactor || [1, 1, 1, 1])[3]
+  m.pbrMetallicRoughness.baseColorFactor = [1, 1, 1, a === undefined ? 1 : a]
+  const vrm0 = json.extensions && json.extensions.VRM && json.extensions.VRM.materialProperties && json.extensions.VRM.materialProperties[materialIndex]
+  if (vrm0 && vrm0.vectorProperties) {
+    vrm0.vectorProperties._Color = [1, 1, 1, 1]
+    vrm0.vectorProperties._ShadeColor = [0.78, 0.78, 0.78, 1] // the shaded side: the same pattern, a little darker
+  }
+  const mtoon = m.extensions && m.extensions.VRMC_materials_mtoon
+  if (mtoon) mtoon.shadeColorFactor = [0.78, 0.78, 0.78]
+}
+
+export async function setTexture(materialIndex: number, bytes: Uint8Array, mime: string): Promise<File> {
+  const img = appendImage(bytes, mime)
+  setMaterialImage(materialIndex, img)
+  whiten(materialIndex)
+  return rebuild()
+}
+
+export async function setPattern(materialIndex: number, spec: PatternSpec): Promise<File> {
+  const png = await renderPattern(spec)
+  return setTexture(materialIndex, png, 'image/png')
+}
+
+// ── Hide / restore / delete ──────────────────────────────────────────────────
+
+export async function hideGarment(materialIndex: number): Promise<File> {
+  const json = VRMParser.json
+  json.meshes.forEach((m: any, mi: number) => {
+    const keep: any[] = []
+    for (const p of m.primitives) { if (p.material === materialIndex) stash.push({ meshIndex: mi, prim: p, materialIndex }); else keep.push(p) }
+    m.primitives = keep
+  })
+  return rebuild()
+}
+
+export async function restoreGarment(materialIndex: number): Promise<File> {
+  const json = VRMParser.json
+  for (let i = stash.length - 1; i >= 0; i--) {
+    const s = stash[i]
+    if (s.materialIndex !== materialIndex) continue
+    json.meshes[s.meshIndex].primitives.push(s.prim)
+    stash.splice(i, 1)
+  }
+  return rebuild()
+}
+
+/** Deletes the garment for good: its primitives are gone and cannot be restored. (Its data stays in the binary chunk, unused.) */
+export async function deleteGarment(materialIndex: number): Promise<File> {
+  const json = VRMParser.json
+  json.meshes.forEach((m: any) => { m.primitives = m.primitives.filter((p: any) => p.material !== materialIndex) })
+  for (let i = stash.length - 1; i >= 0; i--) if (stash[i].materialIndex === materialIndex) stash.splice(i, 1)
+  // the material is renamed so it is no longer a garment: it drops out of the list, and indices of everything else stay valid
+  json.materials[materialIndex].name = json.materials[materialIndex].name.replace(/_CLOTH$/, '_DELETED')
+  return rebuild()
+}
+
+export function clearStash() { stash.length = 0 }
+
+// ── Create: patterns and outfits ─────────────────────────────────────────────
+
+export const PATTERNS: Array<{ id: string; label: string }> = [
+  { id: 'solid', label: 'Solid' }, { id: 'stripes-h', label: 'Stripes (horizontal)' }, { id: 'stripes-v', label: 'Stripes (vertical)' },
+  { id: 'pinstripe', label: 'Pinstripe' }, { id: 'plaid', label: 'Plaid' }, { id: 'tartan', label: 'Tartan' }, { id: 'gingham', label: 'Gingham' },
+  { id: 'checker', label: 'Checkerboard' }, { id: 'dots', label: 'Polka dots' }, { id: 'denim', label: 'Denim' }, { id: 'camo', label: 'Camouflage' },
+  { id: 'houndstooth', label: 'Houndstooth' }, { id: 'herringbone', label: 'Herringbone' }, { id: 'argyle', label: 'Argyle' }, { id: 'floral', label: 'Floral' },
+  { id: 'stars', label: 'Stars' }, { id: 'leopard', label: 'Leopard' }, { id: 'waves', label: 'Waves' }
+]
+
+// a small deterministic random generator, so the same pattern gives the same texture
+function rng(seed: number) { let s = seed >>> 0; return () => { s = (Math.imul(s, 1664525) + 1013904223) >>> 0; return s / 4294967296 } }
