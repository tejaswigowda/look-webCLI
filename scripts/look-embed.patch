+export function renderPattern(spec: PatternSpec): Promise<Uint8Array> {
+  const size = 1024
+  const c = document.createElement('canvas'); c.width = c.height = size
+  const ctx = c.getContext('2d') as CanvasRenderingContext2D
+  drawPattern(ctx, size, spec)
+  return new Promise((resolve, reject) => c.toBlob(b => b ? b.arrayBuffer().then(buf => resolve(new Uint8Array(buf))) : reject(new Error('PNG encoding failed')), 'image/png'))
+}
