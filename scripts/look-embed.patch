+/** Applies an outfit to the garments the VRM has (tops, bottoms, shoes, one-piece). Returns what it changed. */
+export async function applyOutfit(preset: OutfitPreset): Promise<{ file: File | null; applied: string[] }> {
+  const applied: string[] = []
+  for (const g of listGarments()) {
+    const part: any = (preset.parts as any)[g.kind]
+    if (!part || g.hidden) continue
+    const png = await renderPattern(part as PatternSpec)
+    const img = appendImage(png, 'image/png')
+    setMaterialImage(g.materialIndex, img)
+    whiten(g.materialIndex)
+    applied.push(`${g.kind}: ${(part as PatternSpec).pattern}`)
+  }
+  if (!applied.length) return { file: null, applied }
+  return { file: await rebuild(), applied }
+}
