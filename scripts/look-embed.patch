+<template>
+  <div class="tabContents tabOutfit" v-if="selectTabType == 'tab_outfit'">
+    <div class="outfit-head">
+      <h3>👕 Outfit</h3>
+      <span class="outfit-note">list, recolor, pattern, hide, restore and delete the garments of this VRM; built-in patterns and outfits, no download</span>
+    </div>
+
+    <!-- Read: the garments the VRM has -->
+    <div class="section-title"><span>Garments ({{ garments.length }})</span></div>
+    <div v-if="!garments.length" class="empty">This VRM has no garments (materials named *_CLOTH).</div>
+    <div v-for="g in garments" :key="g.materialIndex" class="garment" :class="{ hidden: g.hidden }">
+      <div class="g-top">
+        <span class="g-icon">{{ icons[g.kind] }}</span>
+        <div class="g-name"><strong>{{ labels[g.kind] }}</strong><span :title="g.name">{{ g.name }}</span></div>
+        <span class="g-state">{{ g.hidden ? 'hidden' : g.primitives + ' mesh' + (g.primitives === 1 ? '' : 'es') }}</span>
+      </div>
+      <div class="g-actions" v-if="!g.hidden">
+        <label class="g-color" title="Color (tints the texture; with a pattern it replaces the pattern's tint)">Color <input type="color" :value="g.color" @change="onColor(g, $event)" /></label>
+        <select v-model="pick[g.materialIndex]" class="g-pattern" title="Pattern">
+          <option value="">Pattern...</option>
+          <option v-for="p in patterns" :key="p.id" :value="p.id">{{ p.label }}</option>
+        </select>
+        <input type="color" v-model="c1[g.materialIndex]" title="Pattern color 1" />
+        <input type="color" v-model="c2[g.materialIndex]" title="Pattern color 2" />
+        <button type="button" :disabled="!pick[g.materialIndex] || busy" @click="onPattern(g)">Apply</button>
+        <button type="button" :disabled="busy" @click="onUpload(g)">Image...</button>
+      </div>
+      <div class="g-actions">
+        <button type="button" v-if="!g.hidden" :disabled="busy" @click="run(() => hide(g.materialIndex))">Hide</button>
+        <button type="button" v-else :disabled="busy" @click="run(() => restore(g.materialIndex))">Restore</button>
+        <button type="button" class="danger" :disabled="busy" @click="onDelete(g)">Delete</button>
+      </div>
+    </div>
+
+    <!-- Create: outfits -->
+    <div class="section-title"><span>Outfits</span><span class="outfit-note">applies to tops, bottoms, shoes and one-pieces the VRM has</span></div>
+    <div class="outfit-grid">
+      <button v-for="o in outfits" :key="o.id" type="button" class="outfit-card" :disabled="busy" :title="o.label" @click="onOutfit(o)">
+        <span class="o-icon">{{ o.icon }}</span><span class="o-label">{{ o.label }}</span>
+      </button>
+    </div>
+
+    <!-- Create: patterns, for the whole outfit -->
+    <div class="section-title"><span>Patterns</span><span class="outfit-note">click to apply to the selected garment kinds</span></div>
+    <div class="pattern-row">
+      <label>On <select v-model="targetKind"><option value="all">all garments</option><option value="tops">tops</option><option value="bottoms">bottoms</option><option value="shoes">shoes</option><option value="onepiece">one-pieces</option></select></label>
+      <input type="color" v-model="pc1" title="Color 1" /><input type="color" v-model="pc2" title="Color 2" />
+    </div>
+    <div class="pattern-grid">
+      <button v-for="p in patterns" :key="p.id" type="button" class="pattern-card" :disabled="busy" @click="onPatternAll(p.id)">
+        <img :src="thumb(p.id)" alt="" /><span>{{ p.label }}</span>
+      </button>
+    </div>
+    <div class="status" v-if="status">{{ status }}</div>
+    <div class="fine">Patterns are painted in the browser and laid over each garment's own texture layout, so on a garment with seams they are an approximation. Hidden garments stay hidden in the exported VRM. Deleting cannot be undone (use Hide to keep it); the VRM file still contains the garment's data, unused.</div>
+  </div>
+</template>
+
+<script lang="ts">
+import { Component, Vue, Prop, Watch } from 'vue-property-decorator'
+import VRMParser from '@/module/VRMParser'
+import { Garment, GarmentKind, OUTFITS, OutfitPreset, PATTERNS, applyOutfit, deleteGarment, hideGarment, listGarments, patternDataUrl, restoreGarment, setColor, setPattern, setTexture } from '@/module/OutfitTools'
+
+@Component({})
+export default class TabOutfit extends Vue {
+  @Prop() selectTabType!: string
+  @Prop() json!: any
+  @Prop() drawVrm!: (file: File) => void
+
+  garments: Garment[] = []
+  patterns = PATTERNS
+  outfits = OUTFITS
+  icons: Record<string, string> = { tops: '👕', bottoms: '👖', shoes: '👟', onepiece: '👗', other: '🧵' }
+  labels: Record<string, string> = { tops: 'Tops', bottoms: 'Bottoms', shoes: 'Shoes', onepiece: 'One-piece', other: 'Garment' }
+  pick: Record<number, string> = {}
+  c1: Record<number, string> = {}
+  c2: Record<number, string> = {}
+  targetKind: GarmentKind | 'all' = 'all'
+  pc1 = '#2f5fd0'
+  pc2 = '#f4f4f6'
+  busy = false
+  status = ''
+  private thumbs: Record<string, string> = {}
+
+  @Watch('json', { immediate: true })
+  onJson() { this.refresh() }
+
+  @Watch('selectTabType')
+  onTab(v: string) { if (v === 'tab_outfit') this.refresh() }
+
+  refresh() {
+    if (!VRMParser.json) { this.garments = []; return }
+    this.garments = listGarments()
+    for (const g of this.garments) {
+      if (this.c1[g.materialIndex] === undefined) { this.$set(this.c1, g.materialIndex, '#2f5fd0'); this.$set(this.c2, g.materialIndex, '#f4f4f6'); this.$set(this.pick, g.materialIndex, '') }
+    }
+  }
+
+  thumb(id: string): string {
+    const key = id + this.pc1 + this.pc2
+    if (!this.thumbs[key]) this.thumbs[key] = patternDataUrl({ pattern: id, c1: this.pc1, c2: this.pc2 })
+    return this.thumbs[key]
+  }
+
+  hide = hideGarment
+  restore = restoreGarment
+
+  async run(fn: () => Promise<File | null>, message: string | (() => string) = '') {
+    if (this.busy) return
+    this.busy = true
+    this.status = 'Working...'
+    try {
+      const file = await fn()
+      if (file && this.drawVrm) this.drawVrm(file)
+      this.refresh()
+      this.status = (typeof message === 'function' ? message() : message) || 'Done.'
+    } catch (e) {
+      console.error('outfit', e)
+      this.status = 'That did not work: ' + ((e as Error).message || e)
+    } finally {
+      this.busy = false
+      setTimeout(() => this.refresh(), 600)
+    }
+  }
+
+  onColor(g: Garment, e: any) { this.run(() => setColor(g.materialIndex, e.target.value)) }
+  onPattern(g: Garment) { this.run(() => setPattern(g.materialIndex, { pattern: this.pick[g.materialIndex], c1: this.c1[g.materialIndex], c2: this.c2[g.materialIndex] })) }
+
+  onUpload(g: Garment) {
+    const input = document.createElement('input')
+    input.type = 'file'; input.accept = 'image/png,image/jpeg'
+    input.onchange = () => {
+      const f = input.files && input.files[0]
+      if (!f) return
+      f.arrayBuffer().then(buf => this.run(() => setTexture(g.materialIndex, new Uint8Array(buf), f.type === 'image/jpeg' ? 'image/jpeg' : 'image/png')))
+    }
+    input.click()
+  }
+
+  onDelete(g: Garment) {
+    if (!window.confirm(`Delete ${this.labels[g.kind]} (${g.name}) for good? Use Hide to keep it.`)) return
+    this.run(() => deleteGarment(g.materialIndex), 'Deleted.')
+  }
+
+  onOutfit(o: OutfitPreset) {
+    let text = ''
+    this.run(async () => {
+      const r = await applyOutfit(o)
+      text = r.applied.length ? `${o.label}: ${r.applied.join(', ')}` : 'This VRM has no matching garments.'
+      return r.file
+    }, () => text)
+  }
+
+  onPatternAll(id: string) {
+    const kinds = this.garments.filter(g => !g.hidden && (this.targetKind === 'all' || g.kind === this.targetKind))
+    if (!kinds.length) { this.status = 'No garments of that kind.'; return }
+    this.run(async () => {
+      let file: File | null = null
+      for (const g of kinds) file = await setPattern(g.materialIndex, { pattern: id, c1: this.pc1, c2: this.pc2 })
+      return file
+    }, `Applied ${id} to ${kinds.length} garment${kinds.length === 1 ? '' : 's'}.`)
+  }
+}
+</script>
+
