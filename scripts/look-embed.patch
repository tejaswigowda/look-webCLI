+    materialIndex: i, name: m.name, kind: kindOf(m.name), primitives: n, hidden: n === 0 && hiddenN > 0,
+    color: rgbToHex(linearToSrgb(f[0]) * 255, linearToSrgb(f[1]) * 255, linearToSrgb(f[2]) * 255), imageIndex: src === undefined ? null : src
+  }
+}
+
+async function rebuild(): Promise<File> {
+  await VRMParser.chunkRebuilding()
+  return VRMParser.createVRMFile()
+}
+
+// ── Update: color ────────────────────────────────────────────────────────────
+
+/** Sets the color the garment renders with: the color factor, the MToon shade color (a little darker) in VRM 0.x and 1.0. */
+function applyColor(materialIndex: number, hex: string) {
+  const json = VRMParser.json, m = json.materials[materialIndex]
+  const [r, g, b] = hexToRgb(hex).map(v => v / 255)
+  const lin = [srgbToLinear(r), srgbToLinear(g), srgbToLinear(b)]
+  const old = (m.pbrMetallicRoughness.baseColorFactor || [1, 1, 1, 1])
+  m.pbrMetallicRoughness.baseColorFactor = [...lin.map(v => +v.toFixed(5)), old[3] === undefined ? 1 : old[3]]
+  const shade = 0.75
+  const vrm0 = json.extensions && json.extensions.VRM && json.extensions.VRM.materialProperties && json.extensions.VRM.materialProperties[materialIndex]
