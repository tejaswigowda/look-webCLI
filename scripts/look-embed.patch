+  }
+  const mtoon = m.extensions && m.extensions.VRMC_materials_mtoon
+  if (mtoon) mtoon.shadeColorFactor = lin.map(v => +(v * shade).toFixed(5))
+}
+
+export async function setColor(materialIndex: number, hex: string): Promise<File> {
+  applyColor(materialIndex, hex)
+  return rebuild()
+}
+
+// ── Update: pattern / uploaded texture ───────────────────────────────────────
+
+/** Appends image bytes to the binary chunk and returns the new image index. */
+function appendImage(bytes: Uint8Array, mime: string): number {
+  const json = VRMParser.json
+  const base = VRMParser.chunk1.chunkData
+  const pad = (4 - (base.length % 4)) % 4
+  const start = base.length + pad
+  const grown = new Uint8Array(start + bytes.length)
+  grown.set(base, 0); grown.set(bytes, start)
+  VRMParser.chunk1.chunkData = grown
+  VRMParser.chunk1.chunkLength = grown.length
+  json.bufferViews = json.bufferViews || []
+  json.bufferViews.push({ buffer: 0, byteOffset: start, byteLength: bytes.length })
